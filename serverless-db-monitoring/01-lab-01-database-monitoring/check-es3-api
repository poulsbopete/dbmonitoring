#!/bin/bash
# Soft check for this narrative demo lab.
# Bootstrap already provisions Kibana + OTel data; do not block learners on
# timing races (generator start, dashboard ID file, etc.).

set +e

echo "Workshop environment check (informational only)..."

if pgrep -f db_otel_generator.py > /dev/null 2>&1; then
  echo "✓ Data generator is running"
else
  echo "• Data generator not visible yet (often still starting — use Kibana tabs)"
fi

if [ -s /tmp/db-monitoring-logs/generator.log ]; then
  echo "✓ Generator log present"
else
  echo "• Generator log not ready yet"
fi

if [ -s /root/workshop/build/db-monitoring/dashboard-ids.txt ]; then
  echo "✓ Dashboards recorded: $(wc -l < /root/workshop/build/db-monitoring/dashboard-ids.txt) id(s)"
else
  echo "• Dashboard ID file not present (dashboards may still be in Kibana)"
fi

echo "CHECK PASS — continue the lab in the Elastic Serverless tab."
exit 0
